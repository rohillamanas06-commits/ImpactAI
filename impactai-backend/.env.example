# =========================================================
# ImpactAI backend — environment configuration
# Copy this file to .env and fill in the real values.
# =========================================================

# ---------- App ----------
APP_NAME=ImpactAI
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: static API key required on every request via the "X-API-Key" header.
# Leave blank to disable auth entirely (fine for local hackathon dev).
API_KEY=

# ---------- Database (Neon Postgres) ----------
# Must be the asyncpg-style URL. Example Neon connection string:
# postgresql+asyncpg://<user>:<password>@<ep-xxxx>.neon.tech/<dbname>?ssl=require
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- AI — Google Gemini (vision + embeddings + text) ----------
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ---------- Optional: alternate LLM providers (not wired in by default, ----------
# ---------- kept here so you can extend ai_service.py to use them) -------
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Uploads ----------
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/webm
